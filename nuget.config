<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The shared local folder feed receives this repository's own pack and
         carries the packages its consumers iterate against. Declared FIRST:
         NuGet prefers the earlier-declared source for the same id and version,
         so a fresh local pack shadows a released package without a version bump.

         THE PATH REACHES OUTSIDE THIS REPOSITORY. Nothing here can enforce it
         and a fresh clone does not satisfy it on its own; it is the one
         concession to the development loop that packs and consumes this library
         locally, and it is the first thing a publication would replace with a
         real feed. Recorded as DECISIONS D6. -->
    <add key="local" value="..\..\local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
